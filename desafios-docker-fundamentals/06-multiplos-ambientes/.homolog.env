# Ambiente de HOMOLOGACAO do fake-shop.
# Para subir com este arquivo:
#
#   docker compose --env-file .homolog.env up -d
#
# Portas diferentes das de dev permitem rodar os dois ambientes
# simultaneamente no mesmo host (util para comparacao lado a lado).

# ── Identificacao do ambiente ─────────────────────────
PROJECT_NAME=fakeshop-homolog
APP_ENV=homologation

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=ecommerce_hml
# IMPORTANTE: evite '@', ':' e '/' em senhas para nao quebrar
# clients que constroem URIs postgresql://user:pass@host/db
POSTGRES_PASSWORD=HomologPg1234!
POSTGRES_DB=fakeshop_hml
POSTGRES_PORT=5436

# ── App fake-shop ─────────────────────────────────────
APP_PORT=5001
