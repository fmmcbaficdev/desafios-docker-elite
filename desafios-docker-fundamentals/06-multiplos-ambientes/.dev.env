# Ambiente de DESENVOLVIMENTO do fake-shop.
# Para subir com este arquivo:
#
#   docker compose --env-file .dev.env up -d
#
# Nota: como este arquivo carrega variaveis por ambiente e nao
# credenciais de producao, ele PODE ir para o git (documenta a config).
# Senhas reais de producao devem ficar em um cofre (Vault, Secrets Manager).

# ── Identificacao do ambiente ─────────────────────────
PROJECT_NAME=fakeshop-dev
APP_ENV=development

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=ecommerce_dev
POSTGRES_PASSWORD=dev1234
POSTGRES_DB=fakeshop_dev
POSTGRES_PORT=5435

# ── App fake-shop ─────────────────────────────────────
APP_PORT=5000
