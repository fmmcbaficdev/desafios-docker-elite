# Template das variaveis de ambiente do stack do blog Rota42.
# COPIE este arquivo para .env e ajuste os valores antes de rodar:
#
#   cp .env.example .env
#
# O .env NAO deve ser commitado (esta no .gitignore).

# ── MySQL ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser
MYSQL_PASSWORD=troque-por-uma-senha-forte

# ── WordPress ─────────────────────────────────────────
# Porta local pela qual o blog fica acessivel: http://localhost:${WORDPRESS_HTTP_PORT}
WORDPRESS_HTTP_PORT=8080
