# Template das variaveis de ambiente do stack kube-news.
# COPIE este arquivo para .env antes de rodar:
#
#   cp .env.example .env
#
# O .env NAO deve ser commitado (esta no .gitignore).

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=kubedev
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=kubedevnews
POSTGRES_PORT=5432

# ── pgAdmin ───────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@rota42.dev
PGADMIN_DEFAULT_PASSWORD=troque-por-uma-senha-forte
PGADMIN_PORT=5050
