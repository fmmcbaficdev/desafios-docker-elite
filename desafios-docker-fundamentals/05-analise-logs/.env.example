# Template das variaveis de ambiente do stack fake-shop.
# COPIE este arquivo para .env antes de rodar:
#
#   cp .env.example .env
#
# O .env NAO deve ser commitado (esta no .gitignore).

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=fakeshop
POSTGRES_PORT=5432

# ── App fake-shop ─────────────────────────────────────
APP_PORT=5000
