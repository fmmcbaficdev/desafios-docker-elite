            {
              "id": "CVE-2026-59985",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "OpenEXR is the reference implementation and specification for the EXR  ..."
              },
              "fullDescription": {
                "text": "OpenEXR is the reference implementation and specification for the EXR image format, widely used in the motion picture industry. OpenEXR versions 3.2.0 through 3.2.10, 3.3.0 through 3.3.12, and 3.4.0 through 3.4.13 are vulnerable on ILP32 builds to a heap out-of-bounds read. The issue occurs when a crafted RLE-compressed EXR causes the 64-bit unpacked size to truncate before allocation in OpenEXRCore decoding.c and unpack_32bit() reads beyond the resulting buffer, allowing denial of service. This issue is fixed in versions 3.2.11, 3.3.13, and 3.4.14."
              },
              "defaultConfiguration": {
                "level": "note"
              },
