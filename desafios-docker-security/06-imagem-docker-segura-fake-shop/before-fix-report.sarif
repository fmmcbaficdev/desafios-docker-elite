            {
              "id": "CVE-2026-80186",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "bluez: Stack Overflow in name2utf8 causes DoS and potential code execution"
              },
              "fullDescription": {
                "text": "A stack-based buffer overflow vulnerability exists in BlueZ, the Linux Bluetooth protocol stack. A remote user within Bluetooth radio range can send a specially crafted Extended Inquiry Response (EIR) packet that causes a buffer overflow when the target device performs Bluetooth discovery. This vulnerability can lead to a Denial of Service (DoS) by crashing the bluetoothd service and may allow for arbitrary code execution."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-80186",
              "help": {
