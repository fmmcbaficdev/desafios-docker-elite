            {
              "id": "CVE-2026-64068",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "kernel: netfs: Fix missing locking around retry adding new subreqs"
              },
              "fullDescription": {
                "text": "In the Linux kernel, the following vulnerability has been resolved:\n\nnetfs: Fix missing locking around retry adding new subreqs\n\nFix netfs_retry_read_subrequests() and netfs_retry_write_stream() to take\nthe appropriate lock when adding extra subrequests into\nstream-\u003esubrequests."
              },
