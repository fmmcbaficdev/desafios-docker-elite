            {
              "id": "CVE-2026-19499",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "glibc: Buffer Overflow in strfmon right-justification padding"
              },
              "fullDescription": {
                "text": "A flaw was found in glibc. The strfmon and strfmon_l functions are vulnerable to a buffer overflow when processing right-justified width padding. This occurs because an incorrect length is used for an internal memory operation, causing data to be written beyond its intended buffer. An attacker could exploit this by providing specially crafted input, potentially leading to arbitrary code execution or other severe impacts."
              },
              "defaultConfiguration": {
                "level": "warning"
