                "cvssv3_baseScore": 5,
                "cvssv3_vector": "CVSS:3.1/AV:L/AC:L/PR:L/UI:R/S:U/C:N/I:N/A:H",
                "precision": "very-high",
                "security-severity": "5.0",
                "tags": [
