                "cvssV3_vector": "CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:N/VA:H/SC:N/SI:N/SA:N/E:P",
                "fixed_version": "0.1.12",
                "purls": [
                  "pkg:npm/path-to-regexp@0.1.7"
                ],
                "security-severity": "7.7",
