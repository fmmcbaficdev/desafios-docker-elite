            {
              "id": "CVE-2026-47165",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-47165"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-47165?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u10",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-48 and 7.1.2-23, the distributed pixel cache was originally designed to operate without a challenge–response authentication model. This has been changed in versions 6.9.13-48 and 7.1.2-23.\n\n---\n- imagemagick 8:7.1.2.23+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-2rgj-gx5x-f62w\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/bb79e91155127dd6c3c18a01c8761e9c2ea82d70 (7.1.2-23)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/2ca87784a434899067b8408e5f8a7f0165a8f884 (6.9.13-48)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-48 and 7.1.2-23, the distributed pixel cache was originally designed to operate without a challenge–response authentication model. This has been changed in versions 6.9.13-48 and 7.1.2-23.\n\n---\n- imagemagick 8:7.1.2.23+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-2rgj-gx5x-f62w\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/bb79e91155127dd6c3c18a01c8761e9c2ea82d70 (7.1.2-23)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/2ca87784a434899067b8408e5f8a7f0165a8f884 (6.9.13-48)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u10                                                                                |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u10                                                                                 |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u10",
