                "cvssV3_severity": "MEDIUM",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:deb/debian/openexr@3.1.5-5?os_distro=bookworm&os_name=debian&os_version=12"
                ],
                "security-severity": "6.5",
                "tags": [
