              "id": "CVE-2024-3205",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2024-3205"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2024-3205?s=debian&n=libyaml&ns=debian&t=deb&osn=debian&osv=12&vr=%3E%3D0.2.5-1",
              "help": {
                "text": "A vulnerability was found in yaml libyaml up to 0.2.5 and classified as critical. Affected by this issue is the function yaml_emitter_emit_flow_sequence_item of the file /src/libyaml/src/emitter.c. The manipulation leads to heap-based buffer overflow. The attack may be launched remotely. The exploit has been disclosed to the public and may be used. The identifier of this vulnerability is VDB-259052. NOTE: The vendor was contacted early about this disclosure but did not respond in any way.\n\n---\nREJECTED\n",
                "markdown": "> A vulnerability was found in yaml libyaml up to 0.2.5 and classified as critical. Affected by this issue is the function yaml_emitter_emit_flow_sequence_item of the file /src/libyaml/src/emitter.c. The manipulation leads to heap-based buffer overflow. The attack may be launched remotely. The exploit has been disclosed to the public and may be used. The identifier of this vulnerability is VDB-259052. NOTE: The vendor was contacted early about this disclosure but did not respond in any way.\n\n---\nREJECTED\n\n|                |                                                                                |\n|----------------|--------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/libyaml@0.2.5-1?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | >=0.2.5-1                                                                      |\n| Fixed version  | not fixed                                                                      |\n"
              },
              "properties": {
                "affected_version": ">=0.2.5-1",
                "cvssV3_severity": "UNSPECIFIED",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:deb/debian/libyaml@0.2.5-1?os_distro=bookworm&os_name=debian&os_version=12"
                ],
                "security-severity": "3.1",
                "tags": [
                  "UNSPECIFIED"
                ]
              }
