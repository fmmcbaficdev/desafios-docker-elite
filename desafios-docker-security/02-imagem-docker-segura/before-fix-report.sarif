            {
              "id": "CVE-2026-28688",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-28688"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-28688?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u8",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-16 and 6.9.13-41, a heap-use-after-free vulnerability exists in the MSL encoder, where a cloned image is destroyed twice. The MSL coder does not support writing MSL so the write capability has been removed. This vulnerability is fixed in 7.1.2-16 and 6.9.13-41.\n\n---\n- imagemagick 8:7.1.2.16+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-xxw5-m53x-j38c\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/40cfaa7b38729eb6a2808c9b94d6baa2fae6219b (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/e2d5b4ff0fb6abf2370af4b3dc483934b4dd63ff (7.1.2-14)\nTODO: For imagemagick6 by fix inside jumbo patch for CVE-2026-28686, first patch was incomplete\nTODO: Fixed by: https://github.com/ImageMagick/ImageMagick6/commit/6a602fb36f181a0089848344a3b0d79fc6155a2b (6.9.13-41)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-16 and 6.9.13-41, a heap-use-after-free vulnerability exists in the MSL encoder, where a cloned image is destroyed twice. The MSL coder does not support writing MSL so the write capability has been removed. This vulnerability is fixed in 7.1.2-16 and 6.9.13-41.\n\n---\n- imagemagick 8:7.1.2.16+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-xxw5-m53x-j38c\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/40cfaa7b38729eb6a2808c9b94d6baa2fae6219b (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/e2d5b4ff0fb6abf2370af4b3dc483934b4dd63ff (7.1.2-14)\nTODO: For imagemagick6 by fix inside jumbo patch for CVE-2026-28686, first patch was incomplete\nTODO: Fixed by: https://github.com/ImageMagick/ImageMagick6/commit/6a602fb36f181a0089848344a3b0d79fc6155a2b (6.9.13-41)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u8                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u8                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u8",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u8",
                "purls": [
                  "pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12"
                ],
                "security-severity": "4.0",
