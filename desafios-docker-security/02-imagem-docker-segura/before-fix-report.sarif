              "shortDescription": {
                "text": "CVE-2026-56361"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-56361?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u12",
              "help": {
                "text": "ImageMagick before 7.1.2-19 contains an off-by-one error in morphology validation allowing out-of-bounds heap buffer reads. Attackers can trigger heap buffer overflow by providing incorrect morphology parameters causing single pixel memory access violations.\n\n---\n- imagemagick 8:7.1.2.19+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-q8h3-jv9v-57qx\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/a6bfb1bb7b4017ec52f5a957641d83ce29b63286 (7.1.2-19)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/cb02de6a5b527edc51982408ad719d76c6699d78 (6.9.13-44)\n",
                "markdown": "> ImageMagick before 7.1.2-19 contains an off-by-one error in morphology validation allowing out-of-bounds heap buffer reads. Attackers can trigger heap buffer overflow by providing incorrect morphology parameters causing single pixel memory access violations.\n\n---\n- imagemagick 8:7.1.2.19+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-q8h3-jv9v-57qx\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/a6bfb1bb7b4017ec52f5a957641d83ce29b63286 (7.1.2-19)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/cb02de6a5b527edc51982408ad719d76c6699d78 (6.9.13-44)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u12                                                                                |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u12                                                                                 |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u12",
                "cvssV3_severity": "UNSPECIFIED",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u12",
                "purls": [
                  "pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12"
