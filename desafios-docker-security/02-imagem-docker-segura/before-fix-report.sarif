            {
              "id": "CVE-2026-33535",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-33535"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-33535?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u8",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-18 and 6.9.13-43, an out-of-bounds write of a zero byte exists in the X11 `display` interaction path that could lead to a crash. Versions 7.1.2-18 and 6.9.13-43 patch the issue.\n\n---\n- imagemagick 8:7.1.2.18+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-mw3m-pqr2-qv7c\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/d3af057fb9d3666762ca3731c2360f544f607f88 (7.1.2-18)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/3bdfa6a73a6c0ba5f2d0986cd2a1892c37f796f3 (6.9.13-43)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-18 and 6.9.13-43, an out-of-bounds write of a zero byte exists in the X11 `display` interaction path that could lead to a crash. Versions 7.1.2-18 and 6.9.13-43 patch the issue.\n\n---\n- imagemagick 8:7.1.2.18+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-mw3m-pqr2-qv7c\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/d3af057fb9d3666762ca3731c2360f544f607f88 (7.1.2-18)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/3bdfa6a73a6c0ba5f2d0986cd2a1892c37f796f3 (6.9.13-43)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u8                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u8                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u8",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u8",
