                ]
              }
            },
            {
              "id": "CVE-2025-14512",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2025-14512"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2025-14512?s=debian&n=glib2.0&ns=debian&t=deb&osn=debian&osv=12&vr=%3C2.74.6-2%2Bdeb12u8",
              "help": {
                "text": "A flaw was found in glib. This vulnerability allows a heap buffer overflow and denial-of-service (DoS) via an integer overflow in GLib's GIO (GLib Input/Output) escape_byte_string() function when processing malicious file or remote filesystem attribute values.\n\n---\n- glib2.0 2.86.3-1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1122346)\n[trixie] - glib2.0 2.84.4-3~deb13u2\n[bookworm] - glib2.0 2.74.6-2+deb12u8\nhttps://gitlab.gnome.org/GNOME/glib/-/issues/3845\nhttps://gitlab.gnome.org/GNOME/glib/-/merge_requests/4935\nhttps://gitlab.gnome.org/GNOME/glib/-/merge_requests/4936\nFixed by: https://gitlab.gnome.org/GNOME/glib/-/commit/4f0399c0aaf3ffc86b5625424580294bc7460404 (2.86.3)\n",
                "markdown": "> A flaw was found in glib. This vulnerability allows a heap buffer overflow and denial-of-service (DoS) via an integer overflow in GLib's GIO (GLib Input/Output) escape_byte_string() function when processing malicious file or remote filesystem attribute values.\n\n---\n- glib2.0 2.86.3-1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1122346)\n[trixie] - glib2.0 2.84.4-3~deb13u2\n[bookworm] - glib2.0 2.74.6-2+deb12u8\nhttps://gitlab.gnome.org/GNOME/glib/-/issues/3845\nhttps://gitlab.gnome.org/GNOME/glib/-/merge_requests/4935\nhttps://gitlab.gnome.org/GNOME/glib/-/merge_requests/4936\nFixed by: https://gitlab.gnome.org/GNOME/glib/-/commit/4f0399c0aaf3ffc86b5625424580294bc7460404 (2.86.3)\n\n|                |                                                                                           |\n|----------------|-------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/glib2.0@2.74.6-2%2Bdeb12u5?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <2.74.6-2+deb12u8                                                                         |\n| Fixed version  | 2.74.6-2+deb12u8                                                                          |\n"
              },
              "properties": {
                "affected_version": "<2.74.6-2+deb12u8",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "2.74.6-2+deb12u8",
                "purls": [
                  "pkg:deb/debian/glib2.0@2.74.6-2%2Bdeb12u5?os_distro=bookworm&os_name=debian&os_version=12"
