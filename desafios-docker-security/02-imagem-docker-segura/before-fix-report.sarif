            {
              "id": "CVE-2026-34238",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-34238"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-34238?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u9",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. In versions below both 7.1.2-19 and 6.9.13-44, an integer overflow in the despeckle operation causes a heap buffer overflow on 32-bit builds that will result in an out of bounds write. This issue has been fixed in versions 6.9.13-44 and 7.1.2-19.\n\n---\n- imagemagick 8:7.1.2.19+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-26qp-ffjh-2x4v\nhttps://github.com/ImageMagick/ImageMagick/commit/bcd8519c70ecd9ebbc180920f2cf97b267d1f440 (7.1.2-19)\nhttps://github.com/ImageMagick/ImageMagick6/commit/4b265a742949437a55e344a3ff694281af266190 (6.9.13-44)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. In versions below both 7.1.2-19 and 6.9.13-44, an integer overflow in the despeckle operation causes a heap buffer overflow on 32-bit builds that will result in an out of bounds write. This issue has been fixed in versions 6.9.13-44 and 7.1.2-19.\n\n---\n- imagemagick 8:7.1.2.19+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-26qp-ffjh-2x4v\nhttps://github.com/ImageMagick/ImageMagick/commit/bcd8519c70ecd9ebbc180920f2cf97b267d1f440 (7.1.2-19)\nhttps://github.com/ImageMagick/ImageMagick6/commit/4b265a742949437a55e344a3ff694281af266190 (6.9.13-44)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u9                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u9                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u9",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u9",
                "purls": [
