            {
              "id": "CVE-2026-24484",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-24484"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-24484?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u7",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, Magick fails to check for multi-layer nested mvg conversions to svg, leading to DoS. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-wg3g-gvx5-2pmv\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/0349df6d43d633bd61bb582d1e1e87d6332de32a (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/f4525ad83d3876a9a07b74ef1fed4cb21a5332dd (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/c47b28f700fc454e4f7c16e197a55149120697ea (6.9.13-39)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/151dcb4f0246d1285cbd756a1f32797894ad5da5 (6.9.13-39)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, Magick fails to check for multi-layer nested mvg conversions to svg, leading to DoS. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-wg3g-gvx5-2pmv\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/0349df6d43d633bd61bb582d1e1e87d6332de32a (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/f4525ad83d3876a9a07b74ef1fed4cb21a5332dd (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/c47b28f700fc454e4f7c16e197a55149120697ea (6.9.13-39)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/151dcb4f0246d1285cbd756a1f32797894ad5da5 (6.9.13-39)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u7                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u7                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u7",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u7",
