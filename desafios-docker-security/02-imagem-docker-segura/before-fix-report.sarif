            {
              "id": "CVE-2026-34544",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-34544"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-34544?s=debian&n=openexr&ns=debian&t=deb&osn=debian&osv=12&vr=%3E0",
              "help": {
                "text": "OpenEXR provides the specification and reference implementation of the EXR file format, an image storage format for the motion picture industry. From version 3.4.0 to before version 3.4.8, a crafted B44 or B44A EXR file can cause an out-of-bounds write in any application that decodes it via exr_decoding_run(). Consequences range from immediate crash (most likely) to corruption of adjacent heap allocations (layout-dependent). This issue has been patched in version 3.4.8.\n\n---\n- openexr 3.4.14-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1132579)\nhttps://github.com/AcademySoftwareFoundation/openexr/security/advisories/GHSA-h762-rhv3-h25v\nFixed by: https://github.com/AcademySoftwareFoundation/openexr/commit/35e7aa35e22c1975606be86e859f31cc1fc598ee (v3.4.8-rc)\n",
                "markdown": "> OpenEXR provides the specification and reference implementation of the EXR file format, an image storage format for the motion picture industry. From version 3.4.0 to before version 3.4.8, a crafted B44 or B44A EXR file can cause an out-of-bounds write in any application that decodes it via exr_decoding_run(). Consequences range from immediate crash (most likely) to corruption of adjacent heap allocations (layout-dependent). This issue has been patched in version 3.4.8.\n\n---\n- openexr 3.4.14-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1132579)\nhttps://github.com/AcademySoftwareFoundation/openexr/security/advisories/GHSA-h762-rhv3-h25v\nFixed by: https://github.com/AcademySoftwareFoundation/openexr/commit/35e7aa35e22c1975606be86e859f31cc1fc598ee (v3.4.8-rc)\n\n|                |                                                                                |\n|----------------|--------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/openexr@3.1.5-5?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | >0                                                                             |\n| Fixed version  | not fixed                                                                      |\n"
              },
              "properties": {
                "affected_version": ">0",
                "cvssV3_severity": "HIGH",
                "fixed_version": "not fixed",
                "purls": [
                  "pkg:deb/debian/openexr@3.1.5-5?os_distro=bookworm&os_name=debian&os_version=12"
                ],
