            {
              "id": "CVE-2026-48733",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-48733"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-48733?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u11",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-49 and 7.1.2-24, an infinite loop in the subimage-search operation can happen when using a crafted image. This issue has been patched in versions 6.9.13-49 and 7.1.2-24.\n\n---\n- imagemagick 8:7.1.2.24+dfsg1-1\n[trixie] - imagemagick <not-affected> (vulnerable code introduced later)\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-5v62-8fq6-cp9m\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/3a12d63368e88350ed838966fcbb67625938cf3a (7.1.2-24)\nIntroduced by: https://github.com/ImageMagick/ImageMagick/commit/9624484e03bee69e8895e36cf5b4a74e52ef39ef (7.1.1-44)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/1a59a4f31acca06f90a1f83424ef991a60f76b61 (6.9.13-49)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 6.9.13-49 and 7.1.2-24, an infinite loop in the subimage-search operation can happen when using a crafted image. This issue has been patched in versions 6.9.13-49 and 7.1.2-24.\n\n---\n- imagemagick 8:7.1.2.24+dfsg1-1\n[trixie] - imagemagick <not-affected> (vulnerable code introduced later)\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-5v62-8fq6-cp9m\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/3a12d63368e88350ed838966fcbb67625938cf3a (7.1.2-24)\nIntroduced by: https://github.com/ImageMagick/ImageMagick/commit/9624484e03bee69e8895e36cf5b4a74e52ef39ef (7.1.1-44)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/1a59a4f31acca06f90a1f83424ef991a60f76b61 (6.9.13-49)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u11                                                                                |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u11                                                                                 |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u11",
                "cvssV3_severity": "LOW",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u11",
                "purls": [
                  "pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12"
                ],
