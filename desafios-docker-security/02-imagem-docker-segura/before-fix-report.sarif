            {
              "id": "CVE-2026-32259",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-32259"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-32259?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u8",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-16 and 6.9.13-41, when a memory allocation fails in the sixel encoder it would be possible to write past the end of a buffer on the stack. This vulnerability is fixed in 7.1.2-16 and 6.9.13-41.\n\n---\n- imagemagick 8:7.1.2.16+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-49hx-7656-jpg3\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/df934b4721173f8dda33c6d007f9811669640e86 (7.1.2-16)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/812ff3ef91967d367aa7a087a31b94f3b2a267ee (6.9.13-41)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to 7.1.2-16 and 6.9.13-41, when a memory allocation fails in the sixel encoder it would be possible to write past the end of a buffer on the stack. This vulnerability is fixed in 7.1.2-16 and 6.9.13-41.\n\n---\n- imagemagick 8:7.1.2.16+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-49hx-7656-jpg3\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/df934b4721173f8dda33c6d007f9811669640e86 (7.1.2-16)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/812ff3ef91967d367aa7a087a31b94f3b2a267ee (6.9.13-41)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u8                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u8                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u8",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u8",
                "purls": [
                  "pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12"
                ],
