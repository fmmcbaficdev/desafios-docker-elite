            {
              "id": "CVE-2026-0989",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-0989"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-0989?s=debian&n=libxml2&ns=debian&t=deb&osn=debian&osv=12&vr=%3C2.9.14%2Bdfsg-1.3%7Edeb12u6",
              "help": {
                "text": "A flaw was identified in the RelaxNG parser of libxml2 related to how external schema inclusions are handled. The parser does not enforce a limit on inclusion depth when resolving nested <include> directives. Specially crafted or overly complex schemas can cause excessive recursion during parsing. This may lead to stack exhaustion and application crashes, creating a denial-of-service risk.\n\n---\n- libxml2 2.15.2+dfsg-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1125691)\n[trixie] - libxml2 2.12.7+dfsg+really2.9.14-2.1+deb13u3\n[bookworm] - libxml2 2.9.14+dfsg-1.3~deb12u6\nhttps://gitlab.gnome.org/GNOME/libxml2/-/issues/998\nhttps://gitlab.gnome.org/GNOME/libxml2/-/merge_requests/374\nFixed by: https://gitlab.gnome.org/GNOME/libxml2/-/commit/66c52b3ac6c32ab112ec2a3bf41e6c30948be113 (v2.15.2)\n",
                "markdown": "> A flaw was identified in the RelaxNG parser of libxml2 related to how external schema inclusions are handled. The parser does not enforce a limit on inclusion depth when resolving nested <include> directives. Specially crafted or overly complex schemas can cause excessive recursion during parsing. This may lead to stack exhaustion and application crashes, creating a denial-of-service risk.\n\n---\n- libxml2 2.15.2+dfsg-0.1 (bug https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1125691)\n[trixie] - libxml2 2.12.7+dfsg+really2.9.14-2.1+deb13u3\n[bookworm] - libxml2 2.9.14+dfsg-1.3~deb12u6\nhttps://gitlab.gnome.org/GNOME/libxml2/-/issues/998\nhttps://gitlab.gnome.org/GNOME/libxml2/-/merge_requests/374\nFixed by: https://gitlab.gnome.org/GNOME/libxml2/-/commit/66c52b3ac6c32ab112ec2a3bf41e6c30948be113 (v2.15.2)\n\n|                |                                                                                                  |\n|----------------|--------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/libxml2@2.9.14%2Bdfsg-1.3~deb12u1?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <2.9.14+dfsg-1.3~deb12u6                                                                         |\n| Fixed version  | 2.9.14+dfsg-1.3~deb12u6                                                                          |\n"
              },
              "properties": {
                "affected_version": "<2.9.14+dfsg-1.3~deb12u6",
                "cvssV3_severity": "LOW",
                "fixed_version": "2.9.14+dfsg-1.3~deb12u6",
                "purls": [
                  "pkg:deb/debian/libxml2@2.9.14%2Bdfsg-1.3~deb12u1?os_distro=bookworm&os_name=debian&os_version=12"
