            {
              "id": "CVE-2026-25576",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-25576"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-25576?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u7",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, a heap buffer over-read vulnerability exists in multiple raw image format handles. The vulnerability occurs when processing images with -extract dimensions larger than -size dimensions, causing out-of-bounds memory reads from a heap-allocated buffer. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-jv4p-gjwq-9r2j\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/077b42643212d7da8c1a4f6b2cd0067ebca8ec0f (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/95db8ba0f445a798e823a86acdebe97de73de449 (6.9.13-39)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/44b3140f3414ebc02c5fa8b80551f7d33950a87a (6.9.13-39)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, a heap buffer over-read vulnerability exists in multiple raw image format handles. The vulnerability occurs when processing images with -extract dimensions larger than -size dimensions, causing out-of-bounds memory reads from a heap-allocated buffer. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-jv4p-gjwq-9r2j\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/077b42643212d7da8c1a4f6b2cd0067ebca8ec0f (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/95db8ba0f445a798e823a86acdebe97de73de449 (6.9.13-39)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/44b3140f3414ebc02c5fa8b80551f7d33950a87a (6.9.13-39)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u7                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u7                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u7",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u7",
                "purls": [
                  "pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12"
                ],
