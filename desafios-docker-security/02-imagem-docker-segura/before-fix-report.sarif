            {
              "id": "CVE-2026-25897",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-25897"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-25897?s=debian&n=imagemagick&ns=debian&t=deb&osn=debian&osv=12&vr=%3C8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u7",
              "help": {
                "text": "ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, an Integer Overflow vulnerability exists in the sun decoder. On 32-bit systems/builds, a carefully crafted image can lead to an out of bounds heap write. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-6j5f-24fw-pqp4\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/23fde73188ea32c15b607571775d4f92bdb75e60 (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/5e28bb254210580ac12234cc9ba4ae57c193129c (6.9.13-39)\n",
                "markdown": "> ImageMagick is free and open-source software used for editing and manipulating digital images. Prior to versions 7.1.2-15 and 6.9.13-40, an Integer Overflow vulnerability exists in the sun decoder. On 32-bit systems/builds, a carefully crafted image can lead to an out of bounds heap write. Versions 7.1.2-15 and 6.9.13-40 contain a patch.\n\n---\n- imagemagick 8:7.1.2.15+dfsg1-1\nhttps://github.com/ImageMagick/ImageMagick/security/advisories/GHSA-6j5f-24fw-pqp4\nFixed by: https://github.com/ImageMagick/ImageMagick/commit/23fde73188ea32c15b607571775d4f92bdb75e60 (7.1.2-14)\nFixed by: https://github.com/ImageMagick/ImageMagick6/commit/5e28bb254210580ac12234cc9ba4ae57c193129c (6.9.13-39)\n\n|                |                                                                                                               |\n|----------------|---------------------------------------------------------------------------------------------------------------|\n| Package        | pkg:deb/debian/imagemagick@8%3A6.9.11.60%2Bdfsg-1.6%2Bdeb12u2?os_distro=bookworm&os_name=debian&os_version=12 |\n| Affected range | <8:6.9.11.60+dfsg-1.6+deb12u7                                                                                 |\n| Fixed version  | 8:6.9.11.60+dfsg-1.6+deb12u7                                                                                  |\n"
              },
              "properties": {
                "affected_version": "<8:6.9.11.60+dfsg-1.6+deb12u7",
                "cvssV3_severity": "MEDIUM",
                "fixed_version": "8:6.9.11.60+dfsg-1.6+deb12u7",
