                "fixed_version": "1:10.11.18-0+deb12u1",
                "purls": [
                  "pkg:deb/debian/mariadb@1%3A10.11.6-0%2Bdeb12u1?os_distro=bookworm&os_name=debian&os_version=12"
                ],
